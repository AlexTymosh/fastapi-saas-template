# ============================================================
# Local application configuration
# ============================================================
# This file is a local development template, not a production
# secret store. Copy it to .env for local work only:
#
#   cp .env.example .env
#
# Staging and production deployments must provide real secrets
# through the deployment platform, Vault, or another secret manager.

APP__NAME=SaaS Template
APP__VERSION=0.1.0
APP__ENVIRONMENT=local
APP__DEBUG=false

API__V1_PREFIX=/api/v1
API__DOCS_ENABLED=true
API__OPENAPI_URL=/openapi.json
API__SCALAR_PATH=/scalar

LOGGING__LEVEL=INFO
LOGGING__AS_JSON=true

REQUEST_CONTEXT__HEADER_NAME=X-Request-ID
REQUEST_CONTEXT__TRUST_INCOMING_REQUEST_ID=true

# ============================================================
# Docker Compose local service credentials
# ============================================================
# These defaults are intentionally weak and local-only.
# compose.yaml uses POSTGRES_* to build container-internal
# DATABASE__URL values that point to the postgres service hostname.
# Do not reuse these defaults in staging or production.

POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app

KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Optional local Vault dev profile token.
# Used only when running:
#   docker compose --profile vault up -d vault vault-init
VAULT_DEV_ROOT_TOKEN_ID=dev-only-root-token

# ============================================================
# Optional Vault application settings
# ============================================================
# Vault is disabled by default for local development. The Vault
# Compose service is a dev/demo integration profile, not a
# production secret store.
# In production, enabled Vault traffic must use https:// unless an
# explicit private-network exception is approved and configured.
VAULT__ENABLED=false
VAULT__ADDR=http://localhost:8200
VAULT__TOKEN=
VAULT__MOUNT=secret
VAULT__PATH=fastapi-saas-template
VAULT__AUTH_METHOD=token
VAULT__FAIL_FAST=false
VAULT__TLS_REQUIRED=true
VAULT__ALLOW_PLAINTEXT_PRIVATE_NETWORK=false

# ============================================================
# Database
# ============================================================
# Host-local backend URL for running the app directly from PyCharm
# or a terminal outside Docker. Docker Compose overrides DATABASE__URL
# inside app/worker/migrate containers to use the postgres service
# hostname and POSTGRES_* credentials.
# In production, PostgreSQL must use sslmode=require, verify-ca, or
# verify-full unless an explicit private-network exception is approved.
DATABASE__URL=postgresql+psycopg://app:app@localhost:5432/app
DATABASE__ECHO=false
DATABASE__POOL_SIZE=10
DATABASE__MAX_OVERFLOW=20
DATABASE__POOL_TIMEOUT=30
DATABASE__POOL_RECYCLE=1800
DATABASE__HEALTHCHECK_TIMEOUT=1.0
DATABASE__SSL_MODE=
DATABASE__ALLOW_PLAINTEXT_PRIVATE_NETWORK=false

# Redis is optional unless enabled features require it. In production,
# use rediss:// unless an explicit private-network exception is approved.
REDIS__URL=
REDIS__HEALTHCHECK_TIMEOUT=0.5
REDIS__TLS_REQUIRED=true
REDIS__ALLOW_PLAINTEXT_PRIVATE_NETWORK=false

# CORS is disabled by default. Enable only when a browser frontend needs API access,
# and keep origins as an explicit JSON list for pydantic-settings parsing.
CORS__ENABLED=false
CORS__ALLOW_ORIGINS=["http://localhost:3000","http://localhost:5173"]
CORS__ALLOW_CREDENTIALS=false
CORS__ALLOW_METHODS=["GET","POST","PUT","PATCH","DELETE","OPTIONS"]
CORS__ALLOW_HEADERS=["Authorization","Content-Type","X-Request-ID"]
CORS__EXPOSE_HEADERS=["X-Request-ID","Retry-After"]
CORS__MAX_AGE=600

# ============================================================
# Privacy export artifacts
# ============================================================
# Disabled by default. Enable only when testing DSR export artifact generation.
# Local storage is for development/test only. Staging and production must use
# S3-compatible private object storage when privacy exports are enabled.
#
# Run the local worker manually when exports are enabled:
#   cd backend
#   uv run python -m app.commands.privacy_export_worker --once
#
# For staging/prod, never use the default signing secret. Generate a strong value,
# for example:
#   openssl rand -hex 32
PRIVACY_EXPORTS__ENABLED=false
PRIVACY_EXPORTS__STORAGE_BACKEND=local
PRIVACY_EXPORTS__LOCAL_STORAGE_PATH=.local/privacy-exports
PRIVACY_EXPORTS__DOWNLOAD_URL_TTL_SECONDS=900
PRIVACY_EXPORTS__ARTIFACT_RETENTION_DAYS=30
PRIVACY_EXPORTS__MAX_ARTIFACT_SIZE_BYTES=10485760
PRIVACY_EXPORTS__SCHEMA_VERSION=1.0
PRIVACY_EXPORTS__LOCAL_SIGNING_SECRET=dev-only-signing-secret

# S3-compatible storage for staging/prod privacy exports.
# Use HTTPS endpoints in protected environments. The plaintext private-network
# override is only for explicitly controlled private test networks.
PRIVACY_EXPORTS__S3_ENDPOINT_URL=
PRIVACY_EXPORTS__S3_REGION_NAME=
PRIVACY_EXPORTS__S3_BUCKET_NAME=
PRIVACY_EXPORTS__S3_KEY_PREFIX=privacy-exports
PRIVACY_EXPORTS__S3_ACCESS_KEY_ID=
PRIVACY_EXPORTS__S3_SECRET_ACCESS_KEY=
PRIVACY_EXPORTS__S3_SERVER_SIDE_ENCRYPTION=AES256
PRIVACY_EXPORTS__S3_SSE_KMS_KEY_ID=
PRIVACY_EXPORTS__S3_ADDRESSING_STYLE=virtual
PRIVACY_EXPORTS__S3_CONNECT_TIMEOUT_SECONDS=3.0
PRIVACY_EXPORTS__S3_READ_TIMEOUT_SECONDS=10.0
PRIVACY_EXPORTS__S3_MAX_ATTEMPTS=3
PRIVACY_EXPORTS__S3_ALLOW_PLAINTEXT_PRIVATE_NETWORK=false

# Observability
# By default metrics use OpenTelemetry API no-op behavior.
# Set OBSERVABILITY__METRICS_ENABLED=true, OBSERVABILITY__EXPORTER=otlp,
# and OBSERVABILITY__OTLP_ENDPOINT=http://otel-collector:4318/v1/metrics
# only when an OTLP HTTP collector endpoint is available.
OBSERVABILITY__METRICS_ENABLED=false
OBSERVABILITY__EXPORTER=none
OBSERVABILITY__OTLP_ENDPOINT=
OBSERVABILITY__SERVICE_NAME=
OBSERVABILITY__OTLP_TIMEOUT_SECONDS=2.0
OBSERVABILITY__EXPORT_INTERVAL_MILLIS=60000
OBSERVABILITY__EXPORT_TIMEOUT_MILLIS=2000

# ============================================================
# Processor governance
# ============================================================
# Optional deployment guardrail for staging/prod. When enabled, each configured
# external processor must have governance metadata before startup succeeds.
# Current processor keys checked by Settings are:
#   keycloak: AUTH__ENABLED=true
#   redis: REDIS__URL is set, even if app rate limiting is edge-enforced
#   vault: VAULT__ENABLED=true
#   otlp: OBSERVABILITY__METRICS_ENABLED=true and OBSERVABILITY__EXPORTER=otlp
PROCESSOR_GOVERNANCE__ENABLED=false
PROCESSOR_GOVERNANCE__REQUIRED=true
PROCESSOR_GOVERNANCE__DATA_RESIDENCY_REGION=

# Example only. Keep these commented in local .env files unless testing the guardrail.
# PROCESSOR_GOVERNANCE__PROCESSORS__KEYCLOAK__PURPOSE=identity_and_access_management
# PROCESSOR_GOVERNANCE__PROCESSORS__KEYCLOAK__DATA_CATEGORIES=identity_profile,authentication_events
# PROCESSOR_GOVERNANCE__PROCESSORS__KEYCLOAK__REGION=uk
# PROCESSOR_GOVERNANCE__PROCESSORS__KEYCLOAK__COUNTRY=GB
# PROCESSOR_GOVERNANCE__PROCESSORS__KEYCLOAK__DPA_SIGNED=true
# PROCESSOR_GOVERNANCE__PROCESSORS__KEYCLOAK__RESTRICTED_TRANSFER=false
# PROCESSOR_GOVERNANCE__PROCESSORS__KEYCLOAK__TRANSFER_MECHANISM=not_restricted
#
# PROCESSOR_GOVERNANCE__PROCESSORS__REDIS__PURPOSE=cache_rate_limit_storage_and_async_task_broker
# PROCESSOR_GOVERNANCE__PROCESSORS__REDIS__DATA_CATEGORIES=rate_limit_identifiers,healthcheck_metadata
# PROCESSOR_GOVERNANCE__PROCESSORS__REDIS__REGION=uk
# PROCESSOR_GOVERNANCE__PROCESSORS__REDIS__COUNTRY=GB
# PROCESSOR_GOVERNANCE__PROCESSORS__REDIS__DPA_SIGNED=true
# PROCESSOR_GOVERNANCE__PROCESSORS__REDIS__RESTRICTED_TRANSFER=false
# PROCESSOR_GOVERNANCE__PROCESSORS__REDIS__TRANSFER_MECHANISM=not_restricted

# Enable rate limiting explicitly with RATE_LIMITING__ENABLED=true and set REDIS__URL
# (Docker Compose: redis://redis:6379/0, local Redis: redis://localhost:6379/0).
# RATE_LIMITING__IDENTIFIER_SECRET is required when enabled; generate with:
#   openssl rand -hex 32
# Do not commit real production/staging secrets. Keep this value distinct from
# Keycloak/client/outbox/Fernet/database/Redis secrets. Rotating it resets
# active limiter buckets because Redis keys use HMAC-derived identifiers.
RATE_LIMITING__ENABLED=false
RATE_LIMITING__BACKEND=redis
RATE_LIMITING__REDIS_PREFIX=rate-limit
RATE_LIMITING__TRUST_PROXY_HEADERS=false
# Comma-separated CIDRs for reverse proxies/load balancers allowed to supply
# X-Forwarded-For/X-Real-IP. Spoofed proxy headers from direct clients are ignored.
RATE_LIMITING__TRUSTED_PROXY_CIDRS=
# Enables the pre-auth IP/client limiter for protected API paths. In staging/prod,
# this must stay true unless traffic is verified as rate-limited by a trusted edge.
RATE_LIMITING__PRE_AUTH_ENABLED=true
RATE_LIMITING__IDENTIFIER_SECRET=
# In prod, rate limiting must be enabled either in app or enforced by edge/API gateway.
# Edge-enforced mode requires trusted proxy CIDRs and a timestamped HMAC assertion
# header in the form: t=<unix_timestamp>,v1=<hmac_sha256>.
RATE_LIMITING__ENFORCED_BY_EDGE=false
RATE_LIMITING__EDGE_ASSERTION_HEADER_NAME=
RATE_LIMITING__EDGE_ASSERTION_SECRET=
# Modes: normal, strict, relaxed, panic. relaxed is rejected in prod.
RATE_LIMITING__MODE=normal
# Optional per-policy overrides. Keep unset to use safe declarative defaults.
# In staging/prod, fail_open=true is rejected for sensitive and critical policies.
# RATE_LIMITING__POLICIES__TENANT_WRITE__LIMIT=20
# RATE_LIMITING__POLICIES__TENANT_WRITE__WINDOW_SECONDS=60
# RATE_LIMITING__POLICIES__TENANT_WRITE__FAIL_OPEN=false
RATE_LIMITING__STORAGE_TIMEOUT_SECONDS=1.0

# Keycloak/OIDC JWT validation (OAuth2 Resource Server boundary).
# API callers must send Keycloak access tokens, not ID tokens.
# AUTH__AUDIENCE is the backend API/resource-server audience.
# AUTH__ALLOWED_AUTHORIZED_PARTIES lists OAuth clients allowed to call this API
# (for example frontend/admin clients in the token azp claim).
# AUTH__CLIENT_ID is retained only for backwards-compatible profile mapping context;
# do not use it as the primary production auth control. Tenant/platform authorization
# remains resolved from local database memberships/platform_staff records.
AUTH__ENABLED=false
AUTH__ISSUER_URL=http://keycloak.local:8080/realms/fastapi-saas
AUTH__AUDIENCE=fastapi-api
AUTH__ALLOWED_AUTHORIZED_PARTIES=fastapi-web
AUTH__CLIENT_ID=fastapi-web
AUTH__JWKS_URL=
AUTH__ALGORITHMS=RS256
AUTH__LEEWAY_SECONDS=30
AUTH__DISCOVERY_CACHE_TTL_SECONDS=300
AUTH__JWKS_CACHE_TTL_SECONDS=300
AUTH__REQUIRE_KID=true
AUTH__REQUIRE_IAT=true
AUTH__MAX_TOKEN_LIFETIME_SECONDS=3600
# staging/prod must set AUTH__METADATA_VALIDATION=fail.
AUTH__METADATA_VALIDATION=warn
AUTH__JWKS_REFRESH_COOLDOWN_SECONDS=30.0
AUTH__JWKS_REFRESH_LOCK_TIMEOUT_SECONDS=2.0

# Optional secret for confidential-client integrations outside the runtime JWT path.
SECURITY__KEYCLOAK_CLIENT_SECRET=

# Outbox invite delivery encryption key (Fernet, URL-safe base64-encoded 32-byte key).
# Generate securely and set explicitly for dev/staging/prod.
# local/test can use deterministic fallback for automated tests only.
SECURITY__OUTBOX_TOKEN_ENCRYPTION_KEY=
OUTBOX__INVITE_DELIVERY_ENABLED=true
OUTBOX__STALE_PROCESSING_TIMEOUT_SECONDS=300
OUTBOX__RECOVERY_BATCH_SIZE=100
